{
  "name": "core.portfolio",
  "version": "1.0.0",
  "description": "Cmgs111's core portfolio",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "yarn copy && tsc-watch --onSuccess \"node dist/index.js\" ",
    "test": "jest",
    "test:e2e": "jest --config ./src/testing/e2e/jest-e2e.json --forceExit",
    "build": "tsc",
    "postgres:migrations:generate": "cd \"src/infrastructure/repositories/sequelize\" && yarn build && sequelize-cli migration:generate --name",
    "postgres:migrations:run": "cd \"src/infrastructure/repositories/sequelize\" && yarn build  && sequelize-cli db:migrate",
    "postgres:migrations:revert": "cd \"src/infrastructure/repositories/sequelize\" && yarn build  && sequelize-cli db:migrate:undo",
    "postgres:migrations:delete": "cd \"src/infrastructure/repositories/sequelize\" && yarn build  && sequelize-cli db:migrate:undo:all",
    "psmgt:generate": "yarn postgres:migrations:generate",
    "psmgt:run": "yarn postgres:migrations:run",
    "psmgt:revert": "yarn postgres:migrations:revert"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carlosmgs111/portfolio.git"
  },
  "keywords": [
    "portfolio"
  ],
  "author": "Carlosmgs111",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Carlosmgs111/portfolio/issues"
  },
  "homepage": "https://github.com/Carlosmgs111/portfolio#readme",
  "dependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.12",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.13",
    "@types/hapi": "^18.0.7",
    "@types/hapi__boom": "^9.0.1",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.3",
    "@types/sequelize": "^4.28.14",
    "@types/uuid": "^8.3.4",
    "bcrypt": "^5.0.1",
    "copy": "^0.3.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "hapi": "^18.1.0",
    "jest": "^28.1.3",
    "joi": "^17.6.0",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.5.0",
    "morgan": "^1.10.0",
    "nodemon": "^2.0.19",
    "pg": "^8.7.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.21.3",
    "sqlite3": "^5.0.11",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.18.6",
    "@faker-js/faker": "^7.4.0",
    "@types/faker": "^6.6.9",
    "@types/jest": "^28.1.6",
    "@types/supertest": "^2.0.12",
    "mongoose-data-migrate": "^0.1.2",
    "sequelize-cli": "^6.4.1",
    "sequelize-cli-typescript": "^3.2.0-c",
    "supertest": "^6.2.4",
    "ts-jest": "^28.0.7",
    "tsc-watch": "^5.0.3",
    "typescript": "^4.7.4"
  }
}
