{
  "name": "core.portfolio",
  "version": "1.0.0",
  "description": "Cmgs111's core portfolio",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node dist/index.js PROD",
    "dev": "mkdir \"./dist/infrastructure/templates\" | yarn copy && tsc-watch --onSuccess \"node dist/index.js DEV\" ",
    "copy": "ncp ./src/infrastructure/templates  ./dist/infrastructure/templates",
    "test": "jest",
    "test:e2e": "jest --config ./src/testing/e2e/jest-e2e.json --detectOpenHandles",
    "build": "tsc",
    "postgres:migrations:generate": "cd \"src/infrastructure/repositories/sequelize\" && yarn build && sequelize-cli migration:generate --name",
    "postgres:migrations:run": "cd \"src/infrastructure/repositories/sequelize\" && yarn build  && sequelize-cli db:migrate",
    "postgres:migrations:revert": "cd \"src/infrastructure/repositories/sequelize\" && yarn build  && sequelize-cli db:migrate:undo",
    "postgres:migrations:delete": "cd \"src/infrastructure/repositories/sequelize\" && yarn build  && sequelize-cli db:migrate:undo:all",
    "postgres:migrations:drop": "cd \"src/infrastructure/repositories/sequelize\" && sequelize-cli db:drop",
    "p:m:generate": "yarn postgres:migrations:generate",
    "p:m:run": "yarn postgres:migrations:run",
    "p:m:revert": "yarn postgres:migrations:revert",
    "p:m:drop": "yarn postgres:migrations:drop",
    "p:m:stand": "yarn p:m:revert && yarn p:m:run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carlosmgs111/portfolio.git"
  },
  "keywords": [
    "portfolio"
  ],
  "author": "Carlosmgs111",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Carlosmgs111/portfolio/issues"
  },
  "homepage": "https://github.com/Carlosmgs111/portfolio#readme",
  "dependencies": {
    "@hapi/boom": "^10.0.0",
    "bcrypt": "^5.1.0",
    "bull": "^4.10.2",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "inquirer": "7.0.0",
    "inquirer-loop": "^0.3.0",
    "jest": "^29.3.1",
    "joi": "^17.7.0",
    "jose": "^4.11.1",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.8.0",
    "morgan": "^1.10.0",
    "ncp": "^2.0.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.8.0",
    "pluralize": "^8.0.0",
    "random-words": "^1.2.1",
    "sequelize": "^6.26.0",
    "sequelize-mysql-timestamp": "^1.4.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^7.6.0",
    "@types/bcrypt": "^5.0.0",
    "@types/colors": "^1.2.1",
    "@types/cors": "^2.8.13",
    "@types/crypto-js": "^4.1.1",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.14",
    "@types/hapi__boom": "^9.0.1",
    "@types/inquirer": "^9.0.3",
    "@types/jest": "^29.2.4",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.3",
    "@types/ncp": "^2.0.5",
    "@types/passport": "^1.0.11",
    "@types/passport-jwt": "^3.0.7",
    "@types/passport-local": "^1.0.34",
    "@types/pg": "^8.6.5",
    "@types/pluralize": "^0.0.29",
    "@types/sequelize": "^4.28.14",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.0",
    "migrate-mongoose": "^4.0.0",
    "sequelize-cli": "^6.5.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.0.3",
    "tsc-watch": "^6.0.0",
    "typescript": "^4.9.4"
  }
}
