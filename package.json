{
  "name": "core.portfolio",
  "version": "1.0.0",
  "description": "Cmgs111's core portfolio",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "yarn copy && tsc-watch --onSuccess \"node dist/index.js DEV\" ",
    "test": "jest",
    "test:e2e": "jest --config ./src/testing/e2e/jest-e2e.json --forceExit",
    "build": "tsc",
    "postgres:migrations:generate": "cd \"src/infrastructure/repositories/sequelize\" && yarn build && sequelize-cli migration:generate --name",
    "postgres:migrations:run": "cd \"src/infrastructure/repositories/sequelize\" && yarn build  && sequelize-cli db:migrate",
    "postgres:migrations:revert": "cd \"src/infrastructure/repositories/sequelize\" && yarn build  && sequelize-cli db:migrate:undo",
    "postgres:migrations:delete": "cd \"src/infrastructure/repositories/sequelize\" && yarn build  && sequelize-cli db:migrate:undo:all",
    "postgres:migrations:drop": "cd \"src/infrastructure/repositories/sequelize\" && sequelize-cli db:drop",
    "p:m:generate": "yarn postgres:migrations:generate",
    "p:m:run": "yarn postgres:migrations:run",
    "p:m:revert": "yarn postgres:migrations:revert",
    "p:m:drop": "yarn postgres:migrations:drop",
    "p:m:stand": "yarn p:m:revert && yarn p:m:run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carlosmgs111/portfolio.git"
  },
  "keywords": [
    "portfolio"
  ],
  "author": "Carlosmgs111",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Carlosmgs111/portfolio/issues"
  },
  "homepage": "https://github.com/Carlosmgs111/portfolio#readme",
  "dependencies": {
    "bcrypt": "^5.0.1",
    "copy": "^0.3.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "dotenv": "^16.0.2",
    "express": "^4.18.1",
    "hapi": "^18.1.0",
    "jest": "^29.0.3",
    "joi": "^17.6.0",
    "jose": "^4.9.3",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.6.1",
    "morgan": "^1.10.0",
    "nodemon": "^2.0.20",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.8.0",
    "pg-hstore": "^2.3.4",
    "pluralize": "^8.0.0",
    "sequelize": "^6.23.0",
    "sqlite3": "^5.1.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.18.6",
    "@faker-js/faker": "^7.5.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.12",
    "@types/crypto-js": "^4.1.1",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.14",
    "@types/faker": "^6.6.9",
    "@types/hapi": "^18.0.7",
    "@types/hapi__boom": "^9.0.1",
    "@types/jest": "^29.0.3",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.3",
    "@types/node-jose": "^1.1.10",
    "@types/passport": "^1.0.11",
    "@types/passport-jwt": "^3.0.6",
    "@types/passport-local": "^1.0.34",
    "@types/pluralize": "^0.0.29",
    "@types/sequelize": "^4.28.14",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^8.3.4",
    "mongoose-data-migrate": "^0.1.2",
    "sequelize-cli": "^6.4.1",
    "sequelize-cli-typescript": "^3.2.0-c",
    "supertest": "^6.2.4",
    "ts-jest": "^29.0.1",
    "tsc-watch": "^5.0.3",
    "typescript": "^4.8.3"
  }
}
